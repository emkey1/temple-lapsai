{
  "name": "temple-lapsai",
  "version": "2.0.0",
  "description": "A turn-based isometric party dungeon crawler — a 1982 homage grown a world — with optional LLM-driven expansion.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "open": "node scripts/open.mjs",
    "test": "node --test test/*.test.mjs",
    "simulate": "node scripts/simulate.mjs",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm test",
    "serve": "node scripts/serve.mjs start",
    "serve:stop": "node scripts/serve.mjs stop",
    "serve:status": "node scripts/serve.mjs status"
  },
  "engines": {
    "node": ">=18"
  }
}
