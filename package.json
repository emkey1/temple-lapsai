{
  "name": "temple-of-lapsai-clone",
  "version": "1.0.0",
  "description": "A turn-based retro top-down homage to the Temple of Lapsai, with LLM-driven world expansion.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "open": "node scripts/open.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=18"
  }
}
