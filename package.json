{
  "name": "temple-lapsai",
  "version": "1.0.0",
  "description": "A turn-based retro top-down homage to the dungeon crawlers of 1982, with LLM-driven world expansion.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "open": "node scripts/open.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm test",
    "serve": "node scripts/serve.mjs start",
    "serve:stop": "node scripts/serve.mjs stop",
    "serve:status": "node scripts/serve.mjs status"
  },
  "engines": {
    "node": ">=18"
  }
}
